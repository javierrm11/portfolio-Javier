---
import About from './About.astro';
import Experiencia from './Experiencia.astro';
import Proyectos from './Proyectos.astro';
import Skills from './Skills.astro';
import Contacto from './Contacto.astro';
---
<main>
    <article id="about">
        <div class="hero-inner">
            <div class="hero-badge">
                <span class="hero-badge-dot"></span>
                Disponible para nuevas oportunidades
            </div>

            <div id="info">
                <h2>Desarrollador Web<br><span class="accent">Full Stack</span></h2>
                <p>Construyo aplicaciones web modernas integrando IA para automatizar flujos de trabajo. Especializado en React, Next.js y Supabase.</p>
            </div>

            <div class="hero-metrics">
                <div class="hero-metric">
                    <div class="hero-metric-value">80%</div>
                    <div class="hero-metric-label">Reducción tiempo con IA</div>
                </div>
                <div class="hero-metric">
                    <div class="hero-metric-value">+35%</div>
                    <div class="hero-metric-label">Tráfico orgánico</div>
                </div>
                <div class="hero-metric">
                    <div class="hero-metric-value">3+</div>
                    <div class="hero-metric-label">Proyectos en producción</div>
                </div>
            </div>

            <div class="hero-actions">
                <div id="curriculum">
                    <a href="/Javier_RuizMolero_Curriculum.pdf" download>
                        Descargar CV
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                    </a>
                </div>

                <section id="social-media">
                    <article>
                        <a href="https://github.com/javierrm11" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                            </svg>
                        </a>
                    </article>
                    <article>
                        <a href="https://www.linkedin.com/in/javierrm11" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                                <rect x="2" y="9" width="4" height="12"></rect>
                                <circle cx="4" cy="4" r="2"></circle>
                            </svg>
                        </a>
                    </article>
                    <article>
                        <a href="https://www.instagram.com/javiermdevweb/" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                            </svg>
                        </a>
                    </article>
                </section>
            </div>
        </div>
    </article>

    <About />
    <Experiencia />
    <Proyectos />
    <Skills />
    <Contacto />
</main>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const ease = {
        out: "power3.out",
        inOut: "power2.inOut",
        back: "back.out(1.4)"
    };
    const DURATION = 0.7;
    const STAGGER = 0.08;

    // ── Hero entrance ──────────────────────────────────────────────
    const heroTl = gsap.timeline({ defaults: { ease: ease.out } });
    heroTl
        .from("#header",               { y: -60, opacity: 0, duration: 0.8 })
        .from(".hero-badge",           { y: 16,  opacity: 0, duration: 0.5 }, "-=0.3")
        .from("#info h2",              { y: 32,  opacity: 0, duration: 0.7 }, "-=0.3")
        .from("#info p",               { y: 24,  opacity: 0, duration: 0.6 }, "-=0.4")
        .from(".hero-metric",          { y: 16,  opacity: 0, duration: 0.5, stagger: STAGGER }, "-=0.4")
        .from(".hero-actions",         { y: 12,  opacity: 0, duration: 0.5 }, "-=0.3")
        .from(".scroll-indicator",     { opacity: 0, duration: 0.5 }, "-=0.1");

    // ── Scroll reveal utility ─────────────────────────────────────
    function revealOn(trigger: string, targets: string, stagger = STAGGER) {
        gsap.from(targets, {
            y: 32,
            opacity: 0,
            duration: DURATION,
            stagger,
            ease: ease.out,
            scrollTrigger: { trigger, start: "top 80%", toggleActions: "play none none none" }
        });
    }

    // ── About ─────────────────────────────────────────────────────
    revealOn("#about-me", "#about-me .about-content", 0);
    revealOn("#about-me", "#about-me .image-container", 0);
    revealOn("#about-me", ".tech-pill", 0.04);

    // ── Experience ────────────────────────────────────────────────
    ScrollTrigger.create({
        trigger: ".experience-timeline",
        start: "top 75%",
        onEnter: () => gsap.fromTo(".timeline-line",
            { scaleY: 0, transformOrigin: "top center" },
            { scaleY: 1, duration: 1.5, ease: ease.inOut })
    });

    gsap.utils.toArray<HTMLElement>(".job").forEach((job) => {
        gsap.from(job, {
            y: 32, opacity: 0, duration: DURATION, ease: ease.out,
            scrollTrigger: { trigger: job, start: "top 85%", toggleActions: "play none none none" }
        });
        const dot = job.querySelector(".job-indicator");
        if (dot) {
            gsap.from(dot, {
                scale: 0, opacity: 0, duration: 0.4, ease: ease.back,
                scrollTrigger: { trigger: job, start: "top 85%", toggleActions: "play none none none" }
            });
        }
    });

    // ── Projects ──────────────────────────────────────────────────
    revealOn("#proyectos", ".projects-header", 0);
    gsap.utils.toArray<HTMLElement>(".project-card").forEach((card, i) => {
        gsap.from(card, {
            y: 32, opacity: 0, duration: DURATION, ease: ease.out,
            scrollTrigger: { trigger: card, start: "top 88%", toggleActions: "play none none none" }
        });
        gsap.to(card, {
            y: i % 2 === 0 ? -16 : 16,
            ease: "none",
            scrollTrigger: { trigger: card, start: "top bottom", end: "bottom top", scrub: 1.5 }
        });
    });

    // ── Skills ────────────────────────────────────────────────────
    revealOn("#skills", ".skills-header", 0);
    gsap.utils.toArray<HTMLElement>(".skill-category").forEach((cat, i) => {
        gsap.from(cat, {
            y: 28, opacity: 0, duration: DURATION, delay: i * 0.06, ease: ease.out,
            scrollTrigger: { trigger: cat, start: "top 88%", toggleActions: "play none none none" }
        });
    });

    // ── Contact ───────────────────────────────────────────────────
    revealOn("#contact", ".contact-header", 0);
    gsap.utils.toArray<HTMLElement>(".contact-card, .contact-form-container").forEach((el, i) => {
        gsap.from(el, {
            y: 28, opacity: 0, duration: DURATION, delay: i * 0.07, ease: ease.out,
            scrollTrigger: { trigger: el, start: "top 88%", toggleActions: "play none none none" }
        });
    });

    // ── Footer ────────────────────────────────────────────────────
    gsap.from(".footer-section", {
        y: 24, opacity: 0, duration: DURATION, stagger: 0.1, ease: ease.out,
        scrollTrigger: { trigger: "#footer", start: "top 90%", toggleActions: "play none none none" }
    });

    // ── Header scrolled class ─────────────────────────────────────
    ScrollTrigger.create({
        start: "top -80",
        end: 99999,
        onEnter:     () => document.getElementById("header")?.classList.add("scrolled"),
        onLeaveBack: () => document.getElementById("header")?.classList.remove("scrolled")
    });

    // ── Pause when tab hidden ─────────────────────────────────────
    document.addEventListener("visibilitychange", () => {
        document.hidden
            ? gsap.globalTimeline.pause()
            : gsap.globalTimeline.resume();
    });
</script>
