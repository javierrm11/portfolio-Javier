---
import About from './About.astro';
import Tecnologias from './Tecnologias.astro';
import Proyectos from './Proyectos.astro';
import Contacto from './Contacto.astro';

---
<main>
    <section id="hero" class="hero">
        <div class="hero-inner">
            <!-- Retrato circular con anillo de marca (variante "5" del
                 explorador de diseño en móvil/tablet): por debajo de 1000px
                 va en flujo normal, pequeño, encima del texto — desde 1000px
                 sale del flujo (position:absolute) y se ancla aparte a la
                 derecha, como antes. -->
            <div class="hero-portrait" aria-hidden="true">
                <img src="/javier.webp" alt="" />
            </div>

            <div class="hero-text">
                <div id="info">
                    <span class="hero-eyebrow">Full Stack + IA</span>
                    <h1>Javier Ruiz<br><span class="hero-outline">Molero</span></h1>
                    <p class="hero-tagline">Construyo productos web de extremo a extremo, del backend a la IA.</p>
                </div>
            </div>
        </div>

        <!-- Sobre 1000px se ancla abajo a la derecha del hero (separado del
             bloque de texto, ver .hero-cta-row en main.css); por debajo se
             queda en flujo normal bajo la frase, alineada a la izquierda
             como el resto del bloque. -->
        <div class="hero-cta-row">
            <a href="#contact" class="hero-link">Contacto</a>
            <a href="#proyectos" class="hero-cta">
                Ver proyectos
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17L17 7M9 7h8v8"></path></svg>
            </a>
        </div>
    </section>

    <About />
    <Proyectos />
    <Tecnologias />
    <Contacto />
</main>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // El móvil dispara un evento de resize (mismo ancho, solo el alto
    // cambiado) cuando la barra de direcciones se oculta/muestra al hacer
    // scroll. Por defecto ScrollTrigger puede reaccionar con un refresh()
    // que recalcula las posiciones de inicio/fin de TODOS los triggers de
    // la página — con varias secciones con alturas ligadas al viewport, eso
    // podía sentirse como si el scroll se moviera solo. Este flag le dice a
    // ScrollTrigger que ignore los resize que son solo un cambio de alto en
    // dispositivos táctiles.
    ScrollTrigger.config({ ignoreMobileResize: true });

    const ease = {
        out: "power3.out",
        inOut: "power2.inOut",
        back: "back.out(1.4)"
    };
    const DURATION = 0.7;
    const STAGGER = 0.08;

    // ── Hero entrance ──────────────────────────────────────────────
    const heroTl = gsap.timeline({ defaults: { ease: ease.out } });
    heroTl
        // .header-innFer, NO #header: el transform que deja esta animación
        // convertiría al header en bloque contenedor de sus descendientes
        // fixed, y el overlay del menú móvil (#main-nav, hermano de
        // .header-inner) quedaría recortado a la franja del header.
        .from(".header-inner",         { y: -60, opacity: 0, duration: 0.8 })
        .from(".hero-eyebrow",         { y: 16,  opacity: 0, duration: 0.5 }, "-=0.3")
        .from("#info h2",              { y: 32,  opacity: 0, duration: 0.7 }, "-=0.35")
        .from(".hero-tagline",         { y: 20,  opacity: 0, duration: 0.6 }, "-=0.4")
        .from(".hero-cta-row",         { y: 16,  opacity: 0, duration: 0.5 }, "-=0.35");

    // ── Scroll reveal utility ─────────────────────────────────────
    function revealOn(trigger: string, targets: string, stagger = STAGGER) {
        gsap.from(targets, {
            y: 32,
            opacity: 0,
            duration: DURATION,
            stagger,
            ease: ease.out,
            scrollTrigger: { trigger, start: "top 80%", toggleActions: "play none none none" }
        });
    }

    // ── About ─────────────────────────────────────────────────────
    revealOn("#about-me", ".timeline-item", 0.08);
    revealOn("#about-me", ".about-quote-card", 0.1);

    // ── Tecnologías ───────────────────────────────────────────────
    revealOn("#tecnologias", ".tech-header", 0);
    revealOn("#tecnologias", ".tech-group", 0.04);

    // ── Projects ──────────────────────────────────────────────────
    revealOn("#proyectos", ".projects-header", 0);
    revealOn("#proyectos", ".projects-tab", 0.05);
    revealOn("#proyectos", ".projects-panel-frame", 0.1);

    // ── Contact ───────────────────────────────────────────────────
    revealOn("#contact", ".contact-title", 0);
    revealOn("#contact", ".contact-info-item, .contact-social", 0.08);
    gsap.from(".contact-form-container", {
        y: 32, opacity: 0, duration: DURATION, ease: ease.out,
        scrollTrigger: { trigger: ".contact-form-container", start: "top 85%", toggleActions: "play none none none" }
    });

    // ── Footer ────────────────────────────────────────────────────
    gsap.from(".footer-top", {
        y: 24, opacity: 0, duration: DURATION, stagger: 0.15, ease: ease.out,
        scrollTrigger: { trigger: "#footer", start: "top 90%", toggleActions: "play none none none" }
    });

    // ── Header scrolled class ─────────────────────────────────────
    ScrollTrigger.create({
        start: "top -80",
        end: 99999,
        onEnter:     () => document.getElementById("header")?.classList.add("scrolled"),
        onLeaveBack: () => document.getElementById("header")?.classList.remove("scrolled")
    });

    // ── Pause when tab hidden ─────────────────────────────────────
    document.addEventListener("visibilitychange", () => {
        document.hidden
            ? gsap.globalTimeline.pause()
            : gsap.globalTimeline.resume();
    });
</script>
