---
// Contacto.astro

---
<section id="contact">
    <div class="floating-contact float-1"></div>
    <div class="floating-contact float-2"></div>
    <div class="floating-contact float-3"></div>

    <div class="contact-container">
        <div class="contact-header">
            <h2>Contacto</h2>
            <div class="header-decoration"></div>
        </div>

        <div class="contact-content">
            <div class="phone-wrap">
                <div class="phone">
                    <div class="phone-notch"></div>
                    <div class="phone-screen">
                        <div class="phone-app">
                            <div class="phone-app-header">
                                <span class="phone-app-time">9:41</span>
                                <h4>Contactos</h4>
                            </div>

                            <div class="phone-contact-list">
                                <div class="phone-contact-item">
                                    <div class="phone-contact-icon">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                            <circle cx="12" cy="10" r="3"></circle>
                                        </svg>
                                    </div>
                                    <div class="phone-contact-text">
                                        <h5>Ubicación</h5>
                                        <p>Córdoba, España — remoto también</p>
                                    </div>
                                </div>

                                <a href="mailto:javierrumo2@gmail.com" class="phone-contact-item">
                                    <div class="phone-contact-icon">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                            <polyline points="22,6 12,13 2,6"></polyline>
                                        </svg>
                                    </div>
                                    <div class="phone-contact-text">
                                        <h5>Email</h5>
                                        <p>javierrumo2@gmail.com</p>
                                    </div>
                                </a>

                                <a href="tel:+34611434736" class="phone-contact-item">
                                    <div class="phone-contact-icon">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                        </svg>
                                    </div>
                                    <div class="phone-contact-text">
                                        <h5>Teléfono</h5>
                                        <p>+34 611 43 47 36</p>
                                    </div>
                                </a>

                                <div class="phone-contact-item phone-contact-item--social">
                                    <div class="phone-contact-icon">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                                            <line x1="9" y1="9" x2="9.01" y2="9"></line>
                                            <line x1="15" y1="9" x2="15.01" y2="9"></line>
                                        </svg>
                                    </div>
                                    <div class="phone-contact-text">
                                        <h5>Redes Sociales</h5>
                                        <div class="social-links">
                                            <a href="https://github.com/javierrm11" class="social-link" target="_blank">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                                                </svg>
                                            </a>
                                            <a href="https://www.linkedin.com/in/javierrm11" class="social-link" target="_blank">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                                                    <rect x="2" y="9" width="4" height="12"></rect>
                                                    <circle cx="4" cy="4" r="2"></circle>
                                                </svg>
                                            </a>
                                            <a href="https://www.instagram.com/javiermdevweb/" class="social-link" target="_blank">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-form-container">
                <span class="form-bubble-badge">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Nuevo mensaje
                </span>
                <div class="form-header">
                    <h3>Envíame un Mensaje</h3>
                    <p>Responderé lo antes posible</p>
                </div>
                <form class="contact-form" id="contactForm" action="https://formspree.io/f/mqaybdwj" method="POST">
                    <div class="form-group">
                        <input type="text" class="form-input" placeholder="Tu nombre" name="nombre" required>
                    </div>
                    <div class="form-group">
                        <input type="email" class="form-input" placeholder="Tu email" name="email" required>
                    </div>
                    <div class="form-group">
                        <input type="text" class="form-input" placeholder="Asunto" name="asunto" required>
                    </div>
                    <div class="form-group">
                        <textarea class="form-input" placeholder="Tu mensaje" name="mensaje" required></textarea>
                    </div>
                    <button type="submit" class="submit-btn">
                        Enviar Mensaje
                    </button>
                </form>
                <div class="success-message" id="successMessage">
                    ¡Mensaje enviado con éxito! Te responderé pronto.
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import "../scripts/phone-reveal";
</script>