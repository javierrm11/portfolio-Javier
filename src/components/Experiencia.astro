---
// Experiencia.astro
---

<section id="experiencia">
  <div class="experience-header">
    <span class="section-eyebrow">Trayectoria</span>
    <h2>Experiencia Profesional</h2>
  </div>

  <div class="experience-timeline">
    <div class="timeline-line"></div>

    <!-- Weai — más reciente -->
    <article class="job">
      <div class="job-indicator"></div>
      <div class="job-card">
        <div class="job-header">
          <h3>Desarrollador Web Full Stack</h3>
          <span class="date-badge">Ene 2026 – Feb 2026</span>
        </div>
        <div class="job-company">
          <span>Weai — Colaboración Externa</span>
        </div>
        <ul class="job-achievements">
          <li>Frontend con React y Next.js implementando SSR/SSG para optimización de rendimiento</li>
          <li>Integración de Supabase para autenticación, base de datos y funciones en tiempo real</li>
          <li>API REST de IA para autocompletado de formularios — <strong>80% menos tiempo de trabajo</strong></li>
          <li>Colaboración en equipo Scrum de 3 desarrolladores con control de versiones Git</li>
        </ul>
        <div class="tech-tags">
          <span class="tech-tag">React</span>
          <span class="tech-tag">Next.js</span>
          <span class="tech-tag">Supabase</span>
          <span class="tech-tag">API REST IA</span>
          <span class="tech-tag">TypeScript</span>
          <span class="tech-tag">Scrum</span>
        </div>
      </div>
    </article>

    <!-- Signlab -->
    <article class="job">
      <div class="job-indicator"></div>
      <div class="job-card">
        <div class="job-header">
          <h3>Desarrollador Full Stack</h3>
          <span class="date-badge">Mar 2025 – Jun 2025</span>
        </div>
        <div class="job-company">
          <img src="/signlab.jfif" alt="Signlab" class="job-company-logo" />
          <span>Signlab Nuevas Tecnologías S.L. — Contrato de Prácticas</span>
        </div>
        <ul class="job-achievements">
          <li>Desarrollo de sitios web corporativos optimizados para SEO técnico y rendimiento</li>
          <li>Componentes reutilizables con Vue.js y SASS, estandarizando el diseño</li>
          <li>Optimización de flujos de trabajo con Git y CI/CD, reduciendo errores en producción</li>
        </ul>
        <div class="tech-tags">
          <span class="tech-tag">Vue.js</span>
          <span class="tech-tag">SASS</span>
          <span class="tech-tag">PHP</span>
          <span class="tech-tag">MySQL</span>
          <span class="tech-tag">CI/CD</span>
          <span class="tech-tag">SEO</span>
        </div>
      </div>
    </article>

    <!-- Freelance -->
    <article class="job">
      <div class="job-indicator"></div>
      <div class="job-card">
        <div class="job-header">
          <h3>Desarrollador Full Stack Freelance</h3>
          <span class="date-badge">2024 – Presente</span>
        </div>
        <div class="job-company">
          <span>Proyectos Independientes</span>
        </div>
        <ul class="job-achievements">
          <li>canalplad.es — Sitio corporativo Next.js con SEO técnico, <strong>+35% tráfico orgánico</strong></li>
          <li>apivuelos.es — Seguimiento de vuelos en tiempo real con mapa interactivo y APIs externas</li>
          <li>Plataforma de ocio nocturno (en curso) — directorio de locales, eventos y reservas</li>
        </ul>
        <div class="tech-tags">
          <span class="tech-tag">Next.js</span>
          <span class="tech-tag">Node.js</span>
          <span class="tech-tag">PostgreSQL</span>
          <span class="tech-tag">Leaflet</span>
          <span class="tech-tag">SEO</span>
          <span class="tech-tag">Vercel</span>
        </div>
      </div>
    </article>
  </div>

  <!-- Educación & Certificaciones -->
  <div class="education-block">
    <span class="section-eyebrow">Formación</span>
    <h3>Educación & Certificaciones</h3>
    <div class="education-grid">
      <div class="education-card">
        <div class="education-info">
          <h4>Especialización en IA y Big Data</h4>
          <p>IES Gran Capitán</p>
        </div>
        <span class="education-date">Actualmente</span>
      </div>
      <div class="education-card">
        <div class="education-info">
          <h4>Técnico en Desarrollo de Aplicaciones Web</h4>
          <p>IES Gran Capitán</p>
        </div>
        <span class="education-date">Jun 2025</span>
      </div>
      <div class="education-card">
        <div class="education-info">
          <h4>Técnico en Microinformática y Redes</h4>
          <p>IES Medina Azahara</p>
        </div>
        <span class="education-date">Jun 2023</span>
      </div>
      <div class="education-card cert-card">
        <div class="education-info">
          <h4>Especialización en Python — 59h</h4>
          <p>Udemy · UC-27c62915-f5b0-4387-b281-1dc76031cbd9</p>
        </div>
        <span class="education-date">Mar 2026</span>
      </div>
    </div>
  </div>
</section>
