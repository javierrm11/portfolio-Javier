---
// Proyectos.astro
---
<section id="proyectos">
    <div class="projects-header">
        <span class="section-eyebrow">Trabajos</span>
        <h2>Proyectos Destacados</h2>
        <p class="projects-subtitle">Aplicaciones reales en producción</p>
    </div>

    <section class="projects-grid">
        <!-- canalplad.es -->
        <article class="project-card">
            <div class="project-image">
                <div class="image-overlay"></div>
                <img src="/canalplad.webp" alt="canalplad.es" />
                <div class="project-links">
                    <a href="https://canalplad.es" target="_blank" rel="noopener noreferrer" class="project-link">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                        Ver Live
                    </a>
                </div>
            </div>
            <div class="project-content">
                <div class="project-header">
                    <h3>canalplad.es</h3>
                    <div class="project-badge">SEO</div>
                </div>
                <p class="project-description">
                    Sitio web corporativo con Next.js y SEO técnico optimizado. Incremento del 35% en tráfico orgánico.
                </p>
                <div class="project-tech">
                    <span class="tech-tag">Next.js</span>
                    <span class="tech-tag">SEO técnico</span>
                    <span class="tech-tag">Vercel</span>
                    <span class="tech-tag">TypeScript</span>
                </div>
            </div>
        </article>

        <!-- apivuelos.es -->
        <article class="project-card">
            <div class="project-image">
                <div class="image-overlay"></div>
                <img src="/apivuelos.png" alt="apivuelos.es" />
                <div class="project-links">
                    <a href="https://apivuelos.es" target="_blank" rel="noopener noreferrer" class="project-link">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                        Ver Live
                    </a>
                </div>
            </div>
            <div class="project-content">
                <div class="project-header">
                    <h3>apivuelos.es</h3>
                    <div class="project-badge">Real-time</div>
                </div>
                <p class="project-description">
                    Seguimiento de vuelos en tiempo real con mapa interactivo, estadísticas y APIs externas.
                </p>
                <div class="project-tech">
                    <span class="tech-tag">Next.js</span>
                    <span class="tech-tag">APIs externas</span>
                    <span class="tech-tag">Leaflet</span>
                    <span class="tech-tag">Chart.js</span>
                </div>
            </div>
        </article>

        <!-- Plataforma Ocio Nocturno -->
        <article class="project-card">
            <div class="project-image">
                <div class="image-overlay"></div>
                <div style="width:100%;height:100%;background:linear-gradient(135deg,rgba(99,102,241,0.15),rgba(14,165,233,0.08));display:flex;align-items:center;justify-content:center;">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(99,102,241,0.5)" stroke-width="1.5">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </div>
                <div class="project-links">
                    <span class="project-link" style="cursor:default;opacity:0.6;">En desarrollo</span>
                </div>
            </div>
            <div class="project-content">
                <div class="project-header">
                    <h3>Ocio Nocturno</h3>
                    <div class="project-badge">En curso</div>
                </div>
                <p class="project-description">
                    Plataforma de directorio de locales, eventos y reservas orientada a geolocalización y experiencia móvil.
                </p>
                <div class="project-tech">
                    <span class="tech-tag">Next.js</span>
                    <span class="tech-tag">Node.js</span>
                    <span class="tech-tag">PostgreSQL</span>
                    <span class="tech-tag">Geolocalización</span>
                </div>
            </div>
        </article>
    </section>
</section>
