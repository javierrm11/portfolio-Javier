---
// Skills.astro
---
<section id="skills">
    <div class="skills-header">
        <span class="section-eyebrow">Tecnologías</span>
        <h2>Habilidades</h2>
        <p class="skills-subtitle">Stack completo para construir productos modernos</p>
    </div>

    <div class="skills-grid">
        <!-- Frontend -->
        <article class="skill-category">
            <div class="category-header">
                <div class="category-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="16 18 22 12 16 6"></polyline>
                        <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                </div>
                <h3>Frontend</h3>
            </div>
            <div class="skills-list">
                <span class="skill-tag">HTML5</span>
                <span class="skill-tag">CSS3</span>
                <span class="skill-tag">JavaScript (ES6+)</span>
                <span class="skill-tag">TypeScript</span>
                <span class="skill-tag">React</span>
                <span class="skill-tag">Next.js</span>
                <span class="skill-tag">Vue.js</span>
                <span class="skill-tag">Astro</span>
                <span class="skill-tag">Tailwind CSS</span>
                <span class="skill-tag">Sass</span>
            </div>
        </article>

        <!-- Backend -->
        <article class="skill-category">
            <div class="category-header">
                <div class="category-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12H19M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"></path>
                    </svg>
                </div>
                <h3>Backend</h3>
            </div>
            <div class="skills-list">
                <span class="skill-tag">Node.js</span>
                <span class="skill-tag">Express.js</span>
                <span class="skill-tag">PHP</span>
                <span class="skill-tag">Python</span>
                <span class="skill-tag">MySQL</span>
                <span class="skill-tag">PostgreSQL</span>
                <span class="skill-tag">Supabase</span>
                <span class="skill-tag">Prisma</span>
                <span class="skill-tag">RESTful APIs</span>
            </div>
        </article>

        <!-- Herramientas -->
        <article class="skill-category">
            <div class="category-header">
                <div class="category-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                    </svg>
                </div>
                <h3>Herramientas</h3>
            </div>
            <div class="skills-list">
                <span class="skill-tag">Git & GitHub</span>
                <span class="skill-tag">Docker</span>
                <span class="skill-tag">CI/CD</span>
                <span class="skill-tag">Linux</span>
                <span class="skill-tag">Figma</span>
                <span class="skill-tag">SEO técnico</span>
                <span class="skill-tag">Vercel</span>
                <span class="skill-tag">GitHub Actions</span>
            </div>
        </article>

        <!-- IA & Automatización -->
        <article class="skill-category category-ai">
            <div class="category-header">
                <div class="category-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73A2 2 0 0 1 10 4a2 2 0 0 1 2-2z"></path>
                    </svg>
                </div>
                <h3>IA & Automatización</h3>
            </div>
            <div class="skills-list">
                <span class="skill-tag">Python</span>
                <span class="skill-tag">API REST IA</span>
                <span class="skill-tag">Integración LLMs</span>
                <span class="skill-tag">Automatización flujos</span>
                <span class="skill-tag">Prompt Engineering</span>
                <span class="skill-tag">Big Data</span>
            </div>
        </article>

        <!-- Metodologías -->
        <article class="skill-category">
            <div class="category-header">
                <div class="category-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <h3>Metodologías</h3>
            </div>
            <div class="skills-list">
                <span class="skill-tag">Agile</span>
                <span class="skill-tag">Scrum</span>
                <span class="skill-tag">TDD</span>
                <span class="skill-tag">Code Review</span>
                <span class="skill-tag">Trabajo en equipo</span>
                <span class="skill-tag">Gestión del tiempo</span>
            </div>
        </article>
    </div>
</section>
