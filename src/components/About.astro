---
// About.astro — cronología + tarjeta de cita (variante "B+6" del explorador
// de diseño).
const timeline = [
    { title: 'DAW', desc: 'Formación de base en desarrollo de aplicaciones web.' },
    { title: 'Signlab', desc: 'Experiencia construyendo producto de extremo a extremo.' },
    { title: 'Especialización en IA y Big Data', desc: 'El giro: de construir productos a construir con IA.' },
    { title: 'Weai', desc: 'Aplicando lo aprendido en proyectos full-stack reales.' },
    { title: 'Ingeniería Informática', desc: 'Estudios en curso, compaginados con los proyectos.' },
];
---
<section id="about-me">
    <div class="about-layout">
        <div class="about-timeline">
            <span class="section-eyebrow">Sobre mí</span>
            <h2>Cómo he llegado hasta aquí</h2>

            <ol class="timeline-list">
                {timeline.map((step, i) => (
                    <li class:list={['timeline-item', { 'timeline-item--last': i === timeline.length - 1 }]}>
                        <span class="timeline-rail">
                            <span class="timeline-dot"></span>
                        </span>
                        <div class="timeline-body">
                            <h3>
                                {step.title}
                                {i === timeline.length - 1 && <span class="timeline-current-badge">Actual</span>}
                            </h3>
                            <p>{step.desc}</p>
                        </div>
                    </li>
                ))}
            </ol>
        </div>

        <div class="about-quote-card">
            <div class="about-quote-header">
                <img src="/javier.webp" alt="Javier Ruiz Molero" width="56" height="56" />
                <div>
                    <h3>Javier Ruiz Molero</h3>
                    <span>Full-stack en transición hacia IA</span>
                </div>
            </div>
            <blockquote>
                <span class="quote-mark" aria-hidden="true">&ldquo;</span>
                <p>No quiero ser solo el que sabe usar IA — quiero ser el que la integra en productos que la gente usa de verdad.</p>
            </blockquote>
        </div>
    </div>
</section>
