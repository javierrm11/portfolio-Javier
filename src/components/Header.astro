<header id="header">
  <!-- El overlay del menú (#main-nav) es hermano de .header-inner, NO su
       hijo: la animación de entrada de GSAP (Main.astro) escribe un
       transform, y un transform convierte al elemento en bloque contenedor
       de sus descendientes position:fixed — el overlay quedaba recortado a
       la caja del header (una franja de ~88px) en vez de cubrir la ventana.
       Animando .header-inner el transform vive ahí y el nav se queda fuera
       de su alcance. -->
  <div class="header-inner">
    <div id="header-buttons" class="header-buttons">
      <a href="#contact" class="header-cta">Contáctame</a>
      <button
        id="menu-toggle"
        class="menu-btn"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="menu-bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <nav id="main-nav" aria-label="Navegación principal">
    <ul>
      <li>
        <a href="#about-me" class="nav-link">
          <span class="nav-text">Sobre mí</span>
        </a>
      </li>
      <li>
        <a href="#proyectos" class="nav-link">
          <span class="nav-text">Proyectos</span>
        </a>
      </li>
      <li>
        <a href="#contact" class="nav-link">
          <span class="nav-text">Contacto</span>
        </a>
      </li>
    </ul>

    <a href="#contact" class="nav-cta">Contáctame</a>
  </nav>
</header>
