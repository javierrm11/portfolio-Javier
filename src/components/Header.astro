---
// Cabecera del sitio, la misma en todas las páginas (variante "A · Barra con
// menú de servicios" del explorador de diseño). En la home los enlaces de
// sección son "#seccion"; en el resto de páginas, "/#seccion", porque esos ids
// solo existen en la home. La sección activa se deduce de la URL. El fondo de
// cristal oscuro (#header::before, en header.css) es siempre opaco, así que se
// lee igual sobre la foto del hero que sobre una página clara.
import { plans, formatPrice, contactWa, TEL_HREF, PHONE_DISPLAY } from '../lib/services';

interface Props {
  page?: 'home' | 'blog' | 'servicio';
}
const { page = 'home' } = Astro.props;
const base = page === 'home' ? '' : '/';
const path = Astro.url.pathname;

const section = path.startsWith('/blog')
  ? 'blog'
  : path.startsWith('/servicios')
    ? 'servicios'
    : path.startsWith('/analizador-web')
      ? 'analizador'
      : '';

// "Pide presupuesto" lleva al formulario de la propia página cuando lo tiene
// (servicios y analizador usan #contacto); si no, al de la home.
const ctaHref = page === 'home' ? '#contact' : section === 'servicios' || section === 'analizador' ? '#contacto' : '/#contact';

// Iconos de 24×24 en trazo, uno por servicio.
const ICONS: Record<string, string> = {
  'diseno-web-cordoba': 'M3 5h18v11H3z M8 20h8 M12 16v4',
  'agente-ia-whatsapp': 'M3.5 20.5l1.4-4.2A8.5 8.5 0 1 1 8 19.3z',
  'chatbot-ia': 'M4 5h16v11H8l-4 4z M8 10h8',
  automatizaciones: 'M13 3L5 14h6l-1 7 8-11h-6z',
  'integracion-apis': 'M8 8l-4 4 4 4 M16 8l4 4-4 4 M14 4l-4 16',
  'apps-a-medida': 'M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z',
};

// Los planes de services.ts y la integración de APIs, que tiene página propia
// pero no es un plan (ver src/lib/apiIntegrations.ts).
const byPlan = Object.fromEntries(plans.map((p) => [p.slug, p]));
const services = [
  'diseno-web-cordoba',
  'agente-ia-whatsapp',
  'chatbot-ia',
  'automatizaciones',
  'integracion-apis',
  'apps-a-medida',
].map((slug) => ({
  slug,
  href: `/servicios/${slug}/`,
  title: slug === 'integracion-apis' ? 'Integración de APIs' : byPlan[slug].title,
  price: `desde ${formatPrice(slug === 'integracion-apis' ? 149 : byPlan[slug].priceFrom)}`,
  icon: ICONS[slug],
  current: path === `/servicios/${slug}/`,
}));
---
<header id="header">
  <!-- El overlay del menú (#main-nav) es hermano de .header-inner, NO su
       hijo: la animación de entrada del hero (main.css) escribe un
       transform, y un transform convierte al elemento en bloque contenedor
       de sus descendientes position:fixed — el overlay quedaba recortado a
       la caja del header (una franja de ~88px) en vez de cubrir la ventana.
       Animando .header-inner el transform vive ahí y el nav se queda fuera
       de su alcance. -->
  <div class="header-inner">
    <a href={page === 'home' ? '#hero' : '/'} class="logo-mark" aria-label="Javier Ruiz Molero, inicio">
      <span>JRM</span>
      <span class="logo-sub" aria-hidden="true">Javier Ruiz<br>Webs, apps e IA</span>
    </a>
    <div id="header-buttons" class="header-buttons">
      <a href={TEL_HREF} class="header-phone" aria-label={`Llamar al ${PHONE_DISPLAY}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span class="header-phone-text">{PHONE_DISPLAY.replace('+34 ', '')}</span>
      </a>
      <a href={ctaHref} class="header-cta">Pide presupuesto</a>
      <button
        id="menu-toggle"
        class="menu-btn"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="menu-bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <nav id="main-nav" aria-label="Navegación principal">
    <ul>
      <li class="nav-services">
        <button
          type="button"
          id="nav-services-btn"
          class:list={['nav-link', 'nav-services-btn', { active: section === 'servicios' }]}
          aria-expanded="false"
          aria-controls="nav-services"
        >
          <span class="nav-text">Servicios</span>
          <svg class="nav-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
        <div id="nav-services" class="nav-dropdown" hidden>
          <ul class="nav-dropdown-grid">
            {services.map((s) => (
              <li>
                <a href={s.href} class="nav-service" aria-current={s.current ? 'page' : undefined}>
                  <span class="nav-service-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon}></path></svg>
                  </span>
                  <span class="nav-service-text">
                    <strong>{s.title}</strong>
                    <span>{s.price}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="nav-dropdown-foot">
            <span>¿No sabes cuál? <a href="/analizador-web/">Analiza tu web gratis</a></span>
            <a href={contactWa} class="nav-dropdown-wa" target="_blank" rel="noopener noreferrer">Preguntar por WhatsApp</a>
          </div>
        </div>
      </li>
      <li>
        <a href={`${base}#proyectos`} class="nav-link">
          <span class="nav-text">Proyectos</span>
        </a>
      </li>
      <li>
        <a href="/blog" class:list={['nav-link', { active: section === 'blog' }]} aria-current={section === 'blog' ? 'page' : undefined}>
          <span class="nav-text">Blog</span>
        </a>
      </li>
      <li>
        <a href="/analizador-web/" class:list={['nav-link', { active: section === 'analizador' }]} aria-current={section === 'analizador' ? 'page' : undefined}>
          <span class="nav-text">Analiza tu web</span>
          <span class="nav-badge">Gratis</span>
        </a>
      </li>
      <li>
        <a href={`${base}#about-me`} class="nav-link">
          <span class="nav-text">Sobre mí</span>
        </a>
      </li>
    </ul>

    <!-- Solo en el menú del móvil: las dos formas de contacto, siempre a mano. -->
    <div class="nav-contact">
      <a href={contactWa} class="nav-contact-wa" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href={TEL_HREF} class="nav-contact-tel">Llamar</a>
    </div>
  </nav>
</header>

<script>
  // Cabecera que se oculta al bajar y reaparece al subir (la animación es
  // una transición CSS de `top`, ver header.css — no un transform, que
  // convertiría a #header en bloque contenedor del overlay del menú).
  const header = document.getElementById("header");
  const nav = document.getElementById("main-nav");
  const menuToggle = document.getElementById("menu-toggle");
  const servicesBtn = document.getElementById("nav-services-btn");
  const servicesPanel = document.getElementById("nav-services");

  // Desplegable de servicios: un panel en escritorio y un acordeón dentro del
  // menú en móvil. Es el mismo elemento; solo cambia el CSS.
  const setServices = (open: boolean) => {
    if (!servicesBtn || !servicesPanel) return;
    servicesBtn.setAttribute("aria-expanded", String(open));
    servicesPanel.hidden = !open;
  };

  if (servicesBtn && servicesPanel) {
    servicesBtn.addEventListener("click", () => {
      setServices(servicesBtn.getAttribute("aria-expanded") !== "true");
    });
    // Se cierra al hacer clic fuera, como cualquier desplegable.
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (!servicesBtn.contains(target) && !servicesPanel.contains(target)) setServices(false);
    });
    // Y si el foco sale de él con el teclado.
    servicesPanel.parentElement?.addEventListener("focusout", (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (next && !servicesPanel.parentElement?.contains(next)) setServices(false);
    });
  }

  if (header) {
    const mobile = window.matchMedia("(max-width: 819px)");
    const THRESHOLD = 8;
    const TOP_ZONE = 80;
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const delta = y - lastY;
      const servicesOpen = servicesBtn?.getAttribute("aria-expanded") === "true";
      if (mobile.matches || y < TOP_ZONE || nav?.classList.contains("open") || servicesOpen) {
        header.classList.remove("header--hidden");
      } else if (Math.abs(delta) >= THRESHOLD) {
        header.classList.toggle("header--hidden", delta > 0);
      }
      if (Math.abs(delta) >= THRESHOLD || y < TOP_ZONE) lastY = y;
    };

    window.addEventListener("scroll", () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });

    // Si el foco entra en la cabecera (Tab), que se vea.
    header.addEventListener("focusin", () => header.classList.remove("header--hidden"));
  }

  // Abrir/cerrar el menú móvil, y desplazamiento suave para los enlaces por
  // ancla — vive aquí (no en cada página) para que funcione igual dondequiera
  // que se use esta cabecera.
  if (menuToggle && nav) {
    const setMenu = (open: boolean) => {
      menuToggle.classList.toggle("active", open);
      nav.classList.toggle("open", open);
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      if (!open) setServices(false);
      // Bloquea el scroll de la página mientras el overlay está abierto: si
      // no, el fondo se desplaza por detrás del menú.
      document.body.style.overflow = open ? "hidden" : "";
    };

    menuToggle.addEventListener("click", () => {
      setMenu(!nav.classList.contains("open"));
    });

    // Cualquier enlace del menú (también los del desplegable y los de
    // contacto) lo cierra al pulsarlo.
    nav.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("click", () => setMenu(false));
    });

    // Cerrar también tocando el fondo del overlay (solo el fondo: e.target
    // === nav excluye enlaces y botones).
    nav.addEventListener("click", (e) => {
      if (e.target === nav) setMenu(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (servicesBtn?.getAttribute("aria-expanded") === "true") {
        setServices(false);
        servicesBtn.focus();
      } else if (nav.classList.contains("open")) {
        setMenu(false);
      }
    });

    // Desplazamiento suave SOLO para la navegación por anclas EN LA MISMA
    // página (href="#..."). Un enlace a "/#..." (cabecera en otra página,
    // como el blog) navega de verdad a la home, así que no entra aquí.
    // Antes lo hacía "scroll-behavior: smooth" en <html>, pero eso animaba
    // también los reajustes internos del navegador (ver la nota en
    // global.css), y en móvil se percibía como que la página se movía sola.
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      if (!link) return;
      const id = link.getAttribute("href");
      if (!id || id === "#") return;
      // getElementById y no querySelector: los apartados de los artículos
      // pueden tener ids que empiezan por número ("1-superpowers…"), que no
      // son selectores CSS válidos y hacían saltar un error.
      const target = document.getElementById(decodeURIComponent(id.slice(1)));
      if (!target) return;
      e.preventDefault();
      setMenu(false);
      target.scrollIntoView({
        behavior: prefersReducedMotion ? "auto" : "smooth",
        block: "start",
      });
    });
  }
</script>
