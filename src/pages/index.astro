---
import Header from "../components/Header.astro";
import Main from "../components/Main.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/header.css";
import "../styles/main.css";
import "../styles/footer.css";
import "../styles/about.css";
import "../styles/tecnologias.css";
import "../styles/proyectos.css";
import "../styles/contacto.css";
---

<html lang="es">
  <head>
  <meta charset="utf-8" />
  <!-- El favicon.svg de Astro iba aquí y ganaba a los otros dos: los
       navegadores prefieren SVG, y al ir el último también se imponía por
       orden. Eliminado (fichero incluido) para que quede el logo propio. -->
  <link rel="preload" as="image" href="/hero-desk.webp" fetchpriority="high" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <!-- Sin initial-scale=1, el móvil no fija el zoom a 1:1: en cuanto algo
       en la página desborda aunque sea un poco, el navegador puede
       renderizar la página zoom-out (más ancha que el viewport real y
       escalada para caber), dejando franjas del fondo del propio SO/
       navegador a los lados — el "se sale del body" que se veía en
       iPhone. Con esto el zoom queda anclado a 1:1 desde el arranque. -->
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <!-- Title optimizado -->
  <title>Javier Ruiz Molero | Desarrollador Web Full Stack & IA</title>

  <!-- Meta descriptions mejorada (150-160 caracteres) -->
  <meta
    name="description"
    content="Desarrollador web Full Stack especializado en React, Next.js e integración de IA. Construyo SaaS y aplicaciones modernas con foco en rendimiento y automatización."
  />

  <!-- Keywords más específicas -->
  <meta
    name="keywords"
    content="Javier Ruiz Molero, desarrollador full stack, React, Astro, Node.js, TypeScript, JavaScript, portfolio desarrollador, desarrollo web Madrid, front-end developer, back-end developer"
  />

  <meta name="author" content="Javier Ruiz Molero" />

  <!-- Canonical URL -->
  <link rel="canonical" href="https://www.javierm.dev" />

  <!-- Open Graph mejorado -->
  <meta
    property="og:title"
    content="Javier Ruiz Molero | Desarrollador Web Full Stack"
  />
  <meta
    property="og:description"
    content="Desarrollador web full stack especializado en crear aplicaciones modernas con React, Astro y Node.js. Código limpio y rendimiento óptimo."
  />
  <meta property="og:image" content="https://www.javierm.dev/og-image.jpg" />
  <meta
    property="og:image:alt"
    content="Javier Ruiz Molero - Desarrollador Web"
  />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.javierm.dev" />
  <meta property="og:site_name" content="Javier Ruiz Molero" />
  <meta property="og:locale" content="es_ES" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta
    name="twitter:title"
    content="Javier Ruiz Molero | Desarrollador Web Full Stack"
  />
  <meta
    name="twitter:description"
    content="Desarrollador web full stack especializado en crear aplicaciones modernas con React, Astro y Node.js."
  />
  <meta name="twitter:image" content="https://www.javierm.dev/og-image.jpg" />
  <meta
    name="twitter:image:alt"
    content="Javier Ruiz Molero - Desarrollador Web"
  />

  <!-- Datos estructurados JSON-LD -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Javier Ruiz Molero",
      "jobTitle": "Desarrollador Web Full Stack",
      "url": "https://www.javierm.dev",
      "image": "https://www.javierm.dev/javier.webp",
      "sameAs": [
        "https://github.com/javierrm11",
        "https://www.linkedin.com/in/javiermdev"
      ],
      "knowsAbout": [
        "Desarrollo Web",
        "React",
        "Next.js",
        "Astro",
        "Node.js",
        "TypeScript",
        "JavaScript",
        "Python",
        "Supabase",
        "Inteligencia Artificial",
        "Integración de IA"
      ],
      "workLocation": {
        "@type": "Place",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Córdoba",
          "addressCountry": "ES"
        }
      }
    }
  </script>

  <!-- Preconnect para optimización de fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Karla:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />
  <meta name="googlebot" content="index, follow" />

  <!-- Idioma -->
  <meta http-equiv="content-language" content="es" />
  
</head>
  <body>
    <Header />
    <Main />
    <Footer />
  </body>
</html>
<script>
  // Panel de diagnóstico del scroll: SOLO con ?debug en la URL. Al ser un
  // import dinámico, en una visita normal ni se descarga.
  if (new URLSearchParams(location.search).has("debug")) {
    import("../scripts/scroll-debug");
  }
</script>
<script>
  // El toggle del menú móvil y el desplazamiento suave por ancla viven ahora
  // en Header.astro (así funcionan igual en cualquier página que use esa
  // cabecera). Aquí solo queda lo que es propio de la home: qué enlace del
  // menú se marca activo según la sección visible.
  document.addEventListener("DOMContentLoaded", () => {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            navLinks.forEach((link) => {
              link.classList.remove("active");
              if (link.getAttribute("href") === `#${id}`) {
                link.classList.add("active");
              }
            });
          }
        });
      },
      { root: null, rootMargin: "-20% 0px -80% 0px", threshold: 0 }
    );
    sections.forEach((s) => observer.observe(s));
  });
</script>
