---
import Header from "../components/Header.astro";
import Main from "../components/Main.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/header.css";
import "../styles/main.css";
import "../styles/footer.css";
import "../styles/about.css";
import "../styles/proyectos.css";
import "../styles/contacto.css";
import "../styles/loader.css";
---

<html lang="es">
  <head>
  <meta charset="utf-8" />
  <!-- El favicon.svg de Astro iba aquí y ganaba a los otros dos: los
       navegadores prefieren SVG, y al ir el último también se imponía por
       orden. Eliminado (fichero incluido) para que quede el logo propio. -->
  <link rel="icon" type="image/x-icon" href="/logo.ico" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <!-- Sin initial-scale=1, el móvil no fija el zoom a 1:1: en cuanto algo
       en la página desborda aunque sea un poco, el navegador puede
       renderizar la página zoom-out (más ancha que el viewport real y
       escalada para caber), dejando franjas del fondo del propio SO/
       navegador a los lados — el "se sale del body" que se veía en
       iPhone. Con esto el zoom queda anclado a 1:1 desde el arranque. -->
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <!-- Title optimizado -->
  <title>Javier Ruiz Molero | Desarrollador Web Full Stack & IA</title>

  <!-- Meta descriptions mejorada (150-160 caracteres) -->
  <meta
    name="description"
    content="Desarrollador web Full Stack especializado en React, Next.js e integración de IA. Construyo SaaS y aplicaciones modernas con foco en rendimiento y automatización."
  />

  <!-- Keywords más específicas -->
  <meta
    name="keywords"
    content="Javier Ruiz Molero, desarrollador full stack, React, Astro, Node.js, TypeScript, JavaScript, portfolio desarrollador, desarrollo web Madrid, front-end developer, back-end developer"
  />

  <meta name="author" content="Javier Ruiz Molero" />

  <!-- Canonical URL -->
  <link rel="canonical" href="https://javierm.dev" />

  <!-- Open Graph mejorado -->
  <meta
    property="og:title"
    content="Javier Ruiz Molero | Desarrollador Web Full Stack"
  />
  <meta
    property="og:description"
    content="Desarrollador web full stack especializado en crear aplicaciones modernas con React, Astro y Node.js. Código limpio y rendimiento óptimo."
  />
  <meta property="og:image" content="https://javierm.dev/javier.webp" />
  <meta
    property="og:image:alt"
    content="Javier Ruiz Molero - Desarrollador Web"
  />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://javierm.dev" />
  <meta property="og:site_name" content="Javier Ruiz Molero" />
  <meta property="og:locale" content="es_ES" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta
    name="twitter:title"
    content="Javier Ruiz Molero | Desarrollador Web Full Stack"
  />
  <meta
    name="twitter:description"
    content="Desarrollador web full stack especializado en crear aplicaciones modernas con React, Astro y Node.js."
  />
  <meta name="twitter:image" content="https://javierm.dev/javier.webp" />
  <meta
    name="twitter:image:alt"
    content="Javier Ruiz Molero - Desarrollador Web"
  />

  <!-- Datos estructurados JSON-LD -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Javier Ruiz Molero",
      "jobTitle": "Desarrollador Web Full Stack",
      "url": "https://javierm.dev",
      "image": "https://javierm.dev/javier.webp",
      "sameAs": [
        "https://github.com/javierrm11",
        "https://www.linkedin.com/in/javierrm11",
        "https://www.instagram.com/javiermdevweb/"
      ],
      "knowsAbout": [
        "Desarrollo Web",
        "React",
        "Next.js",
        "Astro",
        "Node.js",
        "TypeScript",
        "JavaScript",
        "Python",
        "Supabase",
        "Inteligencia Artificial",
        "Integración de IA"
      ],
      "workLocation": {
        "@type": "Place",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Córdoba",
          "addressCountry": "ES"
        }
      }
    }
  </script>

  <!-- Preconnect para optimización de fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />
  <meta name="googlebot" content="index, follow" />

  <!-- Idioma -->
  <meta http-equiv="content-language" content="es" />
  
</head>
  <body>
    <div id="page-loader" class="page-loader">
      <div class="page-loader-grid"></div>
      <div class="page-loader-scanline"></div>
      <div class="page-loader-core">
        <svg class="page-loader-ring" viewBox="0 0 120 120">
          <circle class="ring-track" cx="60" cy="60" r="52" />
          <circle class="ring-progress" cx="60" cy="60" r="52" />
          <polyline class="ring-bracket bracket-tl" points="14,34 14,14 34,14" />
          <polyline class="ring-bracket bracket-tr" points="86,14 106,14 106,34" />
          <polyline class="ring-bracket bracket-br" points="106,86 106,106 86,106" />
          <polyline class="ring-bracket bracket-bl" points="34,106 14,106 14,86" />
        </svg>
        <span class="page-loader-mark">JM</span>
      </div>
      <div class="page-loader-status">
        <span class="page-loader-percent"><span id="page-loader-count">0</span>%</span>
        <span id="page-loader-label" class="page-loader-label">Inicializando escena</span>
      </div>
    </div>
    <!-- Capa de fondo fija (gradiente + rejilla). Ver .page-backdrop en
         global.css: sustituye al background-attachment:fixed del body, que
         en iOS Safari provocaba saltos del fondo al hacer scroll. -->
    <div class="page-backdrop"></div>
    <div class="aurora-bg">
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
    </div>
    <div class="scanline-overlay"></div>
    <div class="noise-overlay"></div>
    <div class="circuit-parallax">
      <div class="circuit-layer circuit-layer-1"></div>
      <div class="circuit-layer circuit-layer-2"></div>
      <div class="circuit-layer circuit-layer-3"></div>
    </div>
    <Header />
    <Main />
    <Footer />
  </body>
</html>
<script>
  import "../scripts/circuit-cursor";
  import "../scripts/circuit-parallax";

  // Panel de diagnóstico del scroll: SOLO con ?debug en la URL. Al ser un
  // import dinámico, en una visita normal ni se descarga.
  if (new URLSearchParams(location.search).has("debug")) {
    import("../scripts/scroll-debug");
  }
</script>
<script>
  // Menu toggle
  document.addEventListener("DOMContentLoaded", () => {
    const menuToggle = document.getElementById("menu-toggle");
    const mainNav = document.getElementById("main-nav");
    if (!menuToggle || !mainNav) return;

    const setMenu = (open: boolean) => {
      menuToggle.classList.toggle("active", open);
      mainNav.classList.toggle("open", open);
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      // Bloquea el scroll de la página mientras el overlay está abierto: si
      // no, el fondo se desplaza por detrás del menú.
      document.body.style.overflow = open ? "hidden" : "";
    };

    menuToggle.addEventListener("click", () => {
      setMenu(!mainNav.classList.contains("open"));
    });

    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    navLinks.forEach((link) => {
      link.addEventListener("click", () => setMenu(false));
    });

    // Cerrar también con el CTA, con Escape y tocando el fondo del overlay
    // (solo el fondo: e.target === mainNav excluye enlaces y botón).
    document.querySelector<HTMLAnchorElement>(".nav-cta")
      ?.addEventListener("click", () => setMenu(false));

    mainNav.addEventListener("click", (e) => {
      if (e.target === mainNav) setMenu(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mainNav.classList.contains("open")) setMenu(false);
    });

    // Desplazamiento suave SOLO para la navegación por anclas. Antes lo
    // hacía "scroll-behavior: smooth" en <html>, pero eso animaba también
    // los reajustes internos del navegador (ver la nota en global.css), y
    // en móvil se percibía como que la página se movía sola. Hecho a mano,
    // solo se anima lo que el usuario pide expresamente.
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      if (!link) return;
      const id = link.getAttribute("href");
      if (!id || id === "#") return;
      const target = document.querySelector(id);
      if (!target) return;
      e.preventDefault();
      setMenu(false);
      target.scrollIntoView({
        behavior: prefersReducedMotion ? "auto" : "smooth",
        block: "start",
      });
    });

    // Active section highlighting
    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            navLinks.forEach((link) => {
              link.classList.remove("active");
              if (link.getAttribute("href") === `#${id}`) {
                link.classList.add("active");
              }
            });
          }
        });
      },
      { root: null, rootMargin: "-20% 0px -80% 0px", threshold: 0 }
    );
    sections.forEach((s) => observer.observe(s));
  });
</script>
