---
import Header from "../components/Header.astro";
import Main from "../components/Main.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import FontPreloads from "../components/FontPreloads.astro";
import "../styles/global.css";
import "../styles/header.css";
import "../styles/main.css";
import "../styles/servicios.css";
import "../styles/footer.css";
import "../styles/about.css";
import "../styles/tecnologias.css";
import "../styles/proyectos.css";
import "../styles/contacto.css";
import { plans, faqs, PHONE, EMAIL } from "../lib/services";

const SITE = "https://www.javierm.dev";

// Negocio local (servicio sin dirección pública, con zona de servicio) +
// la persona que lo lleva + las FAQ de Servicios. Generado desde los mismos
// datos que pinta Servicios.astro, así un cambio de precio no se descuadra.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#negocio`,
      name: "Javier Ruiz Molero · Diseño web e IA",
      description:
        "Desarrollador web freelance en Córdoba (España): páginas web para negocios, agentes IA para WhatsApp, chatbots, automatizaciones y apps a medida.",
      url: `${SITE}/`,
      image: `${SITE}/og-image.jpg`,
      logo: `${SITE}/icon-512.png`,
      telephone: `+${PHONE}`,
      email: EMAIL,
      priceRange: "€",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Córdoba",
        addressRegion: "Andalucía",
        addressCountry: "ES",
      },
      areaServed: [
        { "@type": "City", name: "Córdoba", containedInPlace: { "@type": "AdministrativeArea", name: "Andalucía, España" } },
        { "@type": "Country", name: "España" },
      ],
      founder: { "@id": `${SITE}/#javier` },
      sameAs: ["https://github.com/javierrm11", "https://www.linkedin.com/in/javiermdev"],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Servicios",
        itemListElement: plans.map((p) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: p.title, description: p.description, areaServed: "España" },
          priceSpecification: { "@type": "PriceSpecification", minPrice: p.priceFrom, priceCurrency: "EUR" },
        })),
      },
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#javier`,
      name: "Javier Ruiz Molero",
      jobTitle: "Desarrollador web freelance",
      url: `${SITE}/`,
      image: `${SITE}/javier.webp`,
      worksFor: { "@id": `${SITE}/#negocio` },
      sameAs: ["https://github.com/javierrm11", "https://www.linkedin.com/in/javiermdev"],
      knowsAbout: ["Diseño web", "SEO local", "Inteligencia artificial", "WhatsApp Business API", "Next.js", "Astro", "Supabase"],
      homeLocation: { "@type": "Place", address: { "@type": "PostalAddress", addressLocality: "Córdoba", addressCountry: "ES" } },
    },
    {
      "@type": "FAQPage",
      "@id": `${SITE}/#faq`,
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};

const title = "Diseño web en Córdoba y agentes IA | Javier Ruiz Molero";
const description =
  "Páginas web para negocios en Córdoba desde 349 € y agentes IA que atienden tu WhatsApp. Precio cerrado, entrega en 2–3 semanas. Pide presupuesto.";
---

<html lang="es">
  <head>
  <meta charset="utf-8" />
  <!-- Sin initial-scale=1, el móvil no fija el zoom a 1:1: en cuanto algo
       en la página desborda aunque sea un poco, el navegador puede
       renderizar la página zoom-out (más ancha que el viewport real y
       escalada para caber), dejando franjas del fondo del propio SO/
       navegador a los lados — el "se sale del body" que se veía en
       iPhone. Con esto el zoom queda anclado a 1:1 desde el arranque.
       Va antes que los preload: con él detrás, el móvil evalúa sus media
       como si midiera 980px y descarga también la foto de escritorio. -->
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Antes que cualquier hoja de estilos: sin esta clase, las fotos de debajo
       de la primera pantalla se piden todas al cargar (ver main.css). -->
  <script is:inline>document.documentElement.classList.add('lazy-bg')</script>
  <FontPreloads />
  <link rel="preload" as="image" href="/hero-desk-m.webp" media="(max-width: 819px)" fetchpriority="high" />
  <link rel="preload" as="image" href="/hero-desk.webp" media="(min-width: 820px)" fetchpriority="high" />
  <!-- Favicon propio (J en el anillo de marca, el mismo del retrato del
       hero). El .ico va con sizes="32x32" para que los navegadores con
       soporte SVG prefieran el .svg; el .ico queda para los que no. -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#06142a" />
  <meta name="generator" content={Astro.generator} />

  <!-- Pensado para los clientes (búsquedas tipo "diseño web Córdoba",
       "página web para mi negocio"), no para reclutadores: la ciudad, el
       servicio y el precio de partida van en lo que Google enseña. -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Javier Ruiz Molero" />

  <link rel="canonical" href="https://www.javierm.dev/" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://www.javierm.dev/og-image.jpg" />
  <meta property="og:image:alt" content="Javier Ruiz Molero, diseño web e IA en Córdoba" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.javierm.dev/" />
  <meta property="og:site_name" content="Javier Ruiz Molero" />
  <meta property="og:locale" content="es_ES" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://www.javierm.dev/og-image.jpg" />
  <meta name="twitter:image:alt" content="Javier Ruiz Molero, diseño web e IA en Córdoba" />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />
  <meta name="googlebot" content="index, follow" />

  <!-- Idioma -->
  <meta http-equiv="content-language" content="es" />
  
</head>
  <body>
    <Header />
    <Main />
    <Footer />
    <WhatsAppButton />
  </body>
</html>
<script>
  // Panel de diagnóstico del scroll: SOLO con ?debug en la URL. Al ser un
  // import dinámico, en una visita normal ni se descarga.
  if (new URLSearchParams(location.search).has("debug")) {
    import("../scripts/scroll-debug");
  }
</script>
<script>
  // El toggle del menú móvil y el desplazamiento suave por ancla viven ahora
  // en Header.astro (así funcionan igual en cualquier página que use esa
  // cabecera). Aquí solo queda lo que es propio de la home: qué enlace del
  // menú se marca activo según la sección visible.
  document.addEventListener("DOMContentLoaded", () => {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            navLinks.forEach((link) => {
              link.classList.remove("active");
              if (link.getAttribute("href") === `#${id}`) {
                link.classList.add("active");
              }
            });
          }
        });
      },
      { root: null, rootMargin: "-20% 0px -80% 0px", threshold: 0 }
    );
    sections.forEach((s) => observer.observe(s));

    // Pide la foto de fondo de cada sección una pantalla antes de llegar a ella
    // (la regla que la retiene está en main.css, con la clase lazy-bg).
    const photoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("bg-in");
          photoObserver.unobserve(entry.target);
        });
      },
      { rootMargin: "100% 0px" }
    );
    document
      .querySelectorAll("#about-me, #tecnologias, #proyectos, #contact, #footer")
      .forEach((el) => photoObserver.observe(el));
  });
</script>
