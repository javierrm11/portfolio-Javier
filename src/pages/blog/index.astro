---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CATEGORIES, formatDate, type CategoryKey } from '../../lib/blogCategories';
import '../../styles/global.css';
import '../../styles/header.css';
import '../../styles/footer.css';
import '../../styles/blog.css';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const rest = allPosts.filter((p) => p.id !== featured?.id);

const usedCategories = [...new Set(allPosts.map((p) => p.data.category))] as CategoryKey[];

// Recuento por categoría para el desplegable de móvil/tablet (variante "3"
// del explorador de diseño) — el badge junto al nombre de la categoría.
const categoryCounts = Object.fromEntries(
  usedCategories.map((key) => [key, allPosts.filter((p) => p.data.category === key).length])
) as Record<CategoryKey, number>;
---

<html lang="es">
<head>
  <BaseHead
    title="Blog | Javier Ruiz Molero"
    description="Apuntes sobre desarrollo web e IA: SEO técnico, Next.js, Supabase e integraciones de IA, con casos reales de mis propios proyectos."
    path="/blog"
  />
  <!-- Misma foto de fondo que el Hero de la home: se adelanta su descarga
       igual que allí (ver la nota en index.astro), porque aquí también es
       la imagen más grande de la primera pantalla. -->
  <link rel="preload" as="image" href="/hero-desk.webp" fetchpriority="high" />
</head>
<body>
  <Header page="blog" />

  <main class="blog-main has-hero">
    <section class="blog-hero">
      <div class="blog-hero-inner">
        <span class="blog-eyebrow">Blog</span>
        <h1>Apuntes sobre desarrollo<br>web e IA</h1>
        <p>Notas de proyectos reales: rendimiento, SEO técnico, integraciones con IA y lo que aprendo construyendo productos de punta a punta.</p>

        {featured && (
          <a href={`/blog/${featured.id}/`} class="hero-featured">
            <div class="post-cover">
              <Image src={featured.data.cover} alt="" widths={[240, 480]} sizes="240px" loading="eager" />
            </div>
            <div class="hero-featured-info">
              <span class="hero-featured-badge">Destacado · {CATEGORIES[featured.data.category].label}</span>
              <h2>{featured.data.title}</h2>
              <span class="hero-featured-meta">{featured.data.author} · {formatDate(featured.data.pubDate)} · {featured.data.readTime} min</span>
            </div>
            <span class="hero-featured-read">
              Leer artículo
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17L17 7M9 7h8v8"/></svg>
            </span>
          </a>
        )}
      </div>
    </section>

    <div class="blog-wrap">
      <div class="blog-section-label">
        <h3>Últimos artículos</h3>
      </div>

      {usedCategories.length > 1 && (
        <>
          {/* Móvil/tablet (<900px): desplegable — con 6 categorías, la fila
              de píldoras se salía de pantalla sin dejar claro que había más
              opciones detrás. Es un botón + listbox a mano (no un <select>
              nativo) para poder llevar el punto de color y el contador de
              cada categoría, igual que en escritorio. */}
          <div class="blog-cat-select-wrap">
            <button type="button" id="blog-cat-trigger" class="blog-cat-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="blog-cat-menu">
              <span><span class="k">Categoría:</span> <span id="blog-cat-label">Todos</span></span>
              <span id="blog-cat-count" class="blog-cat-count">{allPosts.length}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <ul id="blog-cat-menu" class="blog-cat-menu" role="listbox" aria-label="Filtrar por categoría" hidden>
              <li role="option" aria-selected="true" data-cat="all" data-count={allPosts.length} class="on">
                <span class="dot" style="background:linear-gradient(135deg,#0066CC,#3b9eff)"></span>Todos
              </li>
              {usedCategories.map((key) => (
                <li role="option" aria-selected="false" data-cat={key} data-count={categoryCounts[key]}>
                  <span class="dot" style={`background:${CATEGORIES[key].color}`}></span>{CATEGORIES[key].label}
                </li>
              ))}
            </ul>
          </div>

          {/* Escritorio (≥900px): la fila de píldoras de siempre. */}
          <div class="blog-pills" id="blog-pills" role="group" aria-label="Filtrar por categoría">
            <button type="button" class="blog-pill" data-cat="all" aria-pressed="true">Todos</button>
            {usedCategories.map((key) => (
              <button type="button" class="blog-pill" data-cat={key} aria-pressed="false">{CATEGORIES[key].label}</button>
            ))}
          </div>
        </>
      )}

      <div class="blog-grid" id="blog-grid">
        {rest.map((post) => {
          const cat = CATEGORIES[post.data.category];
          return (
            <a href={`/blog/${post.id}/`} class="blog-card" data-cat={post.data.category}>
              <div class="post-cover">
                <Image src={post.data.cover} alt="" widths={[350, 700]} sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw" loading="lazy" />
              </div>
              <div class="blog-card-body">
                <span class="blog-card-cat" style={`color:${cat.color}`}><span class="cat-dot" style={`background:${cat.color}`}></span>{cat.label}</span>
                <h4>{post.data.title}</h4>
                <p>{post.data.description}</p>
                <div class="blog-card-foot">
                  <span>{formatDate(post.data.pubDate)}</span>
                  <span class="sep"></span>
                  <span>{post.data.readTime} min</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <p class="blog-empty" id="blog-empty">No hay artículos en esta categoría todavía.</p>
    </div>
  </main>

  <Footer page="blog" />
</body>
</html>

<script>
  // Filtro de categoría, sin recargar página: las tarjetas ya están todas
  // en el HTML (son pocos posts), así que basta con mostrar/ocultar por
  // data-cat. El post destacado no se filtra: siempre queda arriba.
  // Dos controles para la MISMA selección (píldoras en escritorio,
  // desplegable en móvil/tablet — el CSS oculta uno u otro según el
  // ancho): esta función es la única que decide qué tarjetas se ven y deja
  // ambos controles sincronizados, se use el que se use.
  const grid = document.getElementById('blog-grid');
  const empty = document.getElementById('blog-empty');
  const pillsBox = document.getElementById('blog-pills');
  const trigger = document.getElementById('blog-cat-trigger');
  const menu = document.getElementById('blog-cat-menu');
  const label = document.getElementById('blog-cat-label');
  const count = document.getElementById('blog-cat-count');

  if (grid && (pillsBox || menu)) {
    const pills = Array.from(pillsBox?.querySelectorAll<HTMLButtonElement>('.blog-pill') ?? []);
    const options = Array.from(menu?.querySelectorAll<HTMLLIElement>('[role="option"]') ?? []);
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.blog-card'));

    const closeMenu = () => {
      menu?.setAttribute('hidden', '');
      trigger?.setAttribute('aria-expanded', 'false');
    };

    const setCategory = (cat: string | undefined, optionEl?: HTMLLIElement) => {
      if (!cat) return;
      pills.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.cat === cat)));
      options.forEach((o) => {
        const on = o.dataset.cat === cat;
        o.setAttribute('aria-selected', String(on));
        o.classList.toggle('on', on);
      });
      const opt = optionEl ?? options.find((o) => o.dataset.cat === cat);
      if (opt && label && count) {
        label.textContent = opt.textContent?.trim() ?? '';
        count.textContent = opt.dataset.count ?? '';
      }
      let visible = 0;
      cards.forEach((card) => {
        const show = cat === 'all' || card.dataset.cat === cat;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      empty?.classList.toggle('show', visible === 0);
    };

    pillsBox?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.blog-pill');
      if (btn) setCategory(btn.dataset.cat);
    });

    trigger?.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      if (open) closeMenu();
      else { menu?.removeAttribute('hidden'); trigger.setAttribute('aria-expanded', 'true'); }
    });

    menu?.addEventListener('click', (e) => {
      const opt = (e.target as HTMLElement).closest<HTMLLIElement>('[role="option"]');
      if (!opt) return;
      setCategory(opt.dataset.cat, opt);
      closeMenu();
      trigger?.focus();
    });

    document.addEventListener('click', (e) => {
      if (trigger?.getAttribute('aria-expanded') === 'true' && !trigger.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger?.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        trigger.focus();
      }
    });
  }
</script>
